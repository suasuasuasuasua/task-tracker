{
  hooks = {
    check-merge-conflicts.enable = true;
    clang-format.enable = true;
    cmake-format.enable = true;
    deadnix.enable = true;
    end-of-file-fixer.enable = true;
    markdownlint.enable = true;
    nixfmt-rfc-style.enable = true;
    trim-trailing-whitespace.enable = true;
  };
}
